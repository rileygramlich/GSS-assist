PORT=3000

# The public hostname Twilio reaches you on, bare — no https:// prefix.
# Docker/VPS: your real domain. Local testing: whatever ngrok handed you.
PUBLIC_HOSTNAME=receptionist.example.com

# Docker only: the domain Caddy requests a TLS certificate for. Normally the
# same value as PUBLIC_HOSTNAME.
DOMAIN=receptionist.example.com

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Google service account with domain-wide delegation, or per-tenant OAuth refresh tokens.
GOOGLE_CLIENT_EMAIL=receptionist@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
